FROM node:20-alpine AS frontend
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libgmp-dev libmpfr-dev libmpc-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY common.py api.py ./
COPY issuer ./issuer
COPY wallet ./wallet
COPY verifier ./verifier
COPY --from=frontend /app/dist ./static

# Sinh sẵn cred-def lúc build: sinh 2 safe prime 1024-bit mất hàng chục giây, làm lúc runtime sẽ
# khiến request /api/issue đầu tiên trên instance free của Render treo rất lâu.
RUN python -c "from issuer import issuer; issuer.setup()"

CMD ["sh", "-c", "python -m uvicorn api:app --host 0.0.0.0 --port ${PORT:-8000}"]
