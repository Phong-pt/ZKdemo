# Copy to .env (docker compose loads it automatically) and fill in real values.
# Cả 2 biến đều đọc lúc container khởi động (không bake vào bundle), nên đổi giá trị chỉ cần
# restart service `api`, không phải build lại image.

# Google OAuth Client ID (Web application) từ Google Cloud Console — dùng cho nút "Sign in with
# Google" thật ở App A. Không cần client secret (chỉ dùng ID-token flow phía client).
# Authorized JavaScript origins phải khớp origin đang mở app (VD http://localhost:8080 khi chạy
# docker compose, https://<tên-service>.onrender.com khi deploy Render).
# Nếu để trống, App A tự rơi về nút "tài khoản demo" (không xác thực Google thật).
GOOGLE_CLIENT_ID=

# JSON object mở rộng danh sách domain email công ty được issuer công nhận cho Verifier Portal,
# ngoài mặc định {"ntq-solution.com.vn": "NTQ Solution"} trong issuer/issuer.py.
# VD: {"acme.com": "Acme Corp"}
VERIFIER_TRUSTED_DOMAINS_JSON=
